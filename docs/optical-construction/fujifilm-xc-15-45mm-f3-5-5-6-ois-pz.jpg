/* Lens Database Table */
.lensdb {
	border-collapse: collapse;
	margin: 0 auto;
	border: 2px solid transparent;
	border-top: 1px solid;
	border-bottom: 1px solid
}

.lensdb td {
	font-size: 12px;
	font-size: 1.2rem;
	vertical-align: top;
	padding: 10px;
	text-align: center;
	border: 1px solid #696969;
	background: none
}

.lensdb td:hover {
	background: none
}

/* Photo Spots Table */
.db_container {
	font-size: 14px;
	font-size: 1.4rem;
	width: 100%;
	margin: 0
}

.db_container p {
	margin: 0
}

.db_img {
	float: left
}

.db_info {
	padding-top: 15px;
	float: right
}

