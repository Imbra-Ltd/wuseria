---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import { lenses } from "../../data/lenses";
import { mtfReadings } from "../../data/mtf-readings";
import { reviewSourceDirectory } from "../../data/reviews";
import { toSlug } from "../../utils/slug";
import MtfChart from "../../components/static/MtfChart.astro";
import { formatFL } from "../../utils/formatting";
import { opticalFieldCount, OPTICAL_FIELDS } from "../../utils/scoring";
import { generateLensContent } from "../../utils/lens-content";
import type { ScoringStatus } from "../../types/lens";

const SCORING_STATUS_PHRASES: Record<ScoringStatus, string> = {
  niche: "Limited professional review coverage for this lens.",
  new: "Recently released \u2014 professional reviews pending.",
  discontinued: "Discontinued before comprehensive optical testing.",
  specialty: "Standard optical bench tests do not apply to this lens type.",
  pending: "Scoring in progress.",
};

// ADR-052 reason codes humanized for the LOW-confidence badge. Keys
// match `mtfdigitizer.triage.LowReason` values; unknown codes fall
// back to the raw string so a new reason never silently renders blank.
const MTF_REASON_PHRASES: Record<string, string> = {
  precision_below_threshold: "render-match precision below threshold",
  prior_failed_center_ge_edge: "prior failed (center >= edge)",
  prior_failed_low_freq_ge_high: "prior failed (low freq >= high freq)",
  prior_failed_not_suspiciously_flat: "prior failed (curve unusually flat)",
};

export const getStaticPaths = (() => {
  return lenses.map((lens) => ({
    params: { slug: toSlug(`${lens.brand} ${lens.model}`) },
    props: { lens },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { lens } = Astro.props as Props;

const slug = toSlug(`${lens.brand} ${lens.model}`);
const canonicalUrl = new URL(`/lenses/${slug}/`, Astro.site);
const content = generateLensContent(lens, lenses);
const mtf = mtfReadings[slug];

const DASH = "\u2014";

function yesNo(val?: boolean): string {
  if (val == null) return DASH;
  return val ? "Yes" : "No";
}

function num(val: number | undefined, suffix: string): string {
  return val != null ? `${val}${suffix}` : DASH;
}

const opticalFields: [string, number | undefined][] = [
  ["Center (wide open)", lens.centerWideOpen],
  ["Corner (wide open)", lens.cornerWideOpen],
  ["Center (stopped)", lens.centerStopped],
  ["Corner (stopped)", lens.cornerStopped],
  ["Coma", lens.coma],
  ["Astigmatism", lens.astigmatism],
  ["Spherical aberration", lens.sphericalAberration],
  ["Longitudinal CA", lens.longitudinalCA],
  ["Lateral CA", lens.lateralCA],
  ["Distortion", lens.distortion],
  ["Vignetting (wide open)", lens.vignettingWideOpen],
  ["Vignetting (stopped)", lens.vignettingStopped],
  ["Bokeh", lens.bokeh],
  ["Flare resistance", lens.flareResistance],
];

const hasOptical = opticalFields.some(([, v]) => v != null);
const fieldCount = opticalFieldCount(lens);
const totalFields = OPTICAL_FIELDS.length;

const specFields: [string, unknown][] = [
  ["Optical construction", lens.opticalElements],
  ["Coating", lens.coating],
  ["Sweet spot", lens.sweetSpotAperture],
  ["Aperture blades", lens.apertureBlades],
  ["Max magnification", lens.maxMagnification],
  ["Min focus distance", lens.minFocusDistance],
  ["AF motor", lens.afMotor],
  ["OIS", lens.hasOis],
  ["Weather sealed", lens.isWeatherSealed],
  ["Aperture ring", lens.hasApertureRing],
  ["Clickless aperture", lens.isApertureClickless],
  ["Focus ring", lens.hasFocusRing],
  ["Focus by wire", lens.isFocusByWire],
  ["Distance scale", lens.hasDistanceScale],
  ["Rotating front", lens.hasRotatingFront],
  ["Tripod mount", lens.hasTripodMount],
  ["Diameter", lens.diameter],
  ["Length", lens.length],
  ["Filter thread", lens.filterThread],
  ["Year", lens.year],
];
const specCount = specFields.filter(([, v]) => v != null).length;
const specTotal = specFields.length;

const isTiltShift =
  lens.isTiltShift && (lens.shiftRange || lens.tiltAngle || lens.imageCircle);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${lens.brand} ${lens.model}`,
  description: content.metaDescription,
  brand: { "@type": "Brand", name: lens.brand },
  url: canonicalUrl.href,
  ...(lens.officialUrl && { sameAs: lens.officialUrl }),
};
---

<Base
  title={`${lens.brand} ${lens.model} Review Data — Wuseria`}
  description={content.metaDescription}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <div class="detail">
    {/* ── Header ── */}
    <header class="header">
      <h1>{lens.brand} {lens.model}</h1>
    </header>

    {/* ── Table of Contents ── */}
    <nav class="toc" aria-label="Table of contents">
      <ol>
        <li><a href="#summary">Summary</a></li>
        <li><a href="#specifications">Specifications</a></li>
        <li><a href="#optical-quality">Optical Quality</a></li>
        {
          content.genreFit.length > 0 && (
            <li>
              <a href="#genre-fit">Genre Fit</a>
            </li>
          )
        }
        {
          lens.reviewSources && Object.keys(lens.reviewSources).length > 0 && (
            <li>
              <a href="#reviews">Reviews</a>
            </li>
          )
        }
        {
          lens.communityNotes && lens.communityNotes.length > 0 && (
            <li>
              <a href="#community">Community</a>
            </li>
          )
        }
        {
          content.alternatives.length > 0 && (
            <li>
              <a href="#alternatives">Alternatives</a>
            </li>
          )
        }
      </ol>
    </nav>

    {/* ── 1. Summary ── */}
    <section class="card">
      <h2 id="summary">Summary</h2>
      <p class="verdict">
        {content.summary.verdict}{" "}
        The lens is priced at approximately ~${lens.price} USD.
        {
          lens.officialUrl && (
            <>
              {" "}
              Please check the{" "}
              <a
                href={lens.officialUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                official product page
              </a>{" "}
              for sample images, manuals, and firmware updates.
            </>
          )
        }
      </p>
      {
        content.summary.genreTiers.length > 0 && (
          <div class="summary-col">
            <h3>Genre Suitability</h3>
            <ul>
              {content.summary.genreTiers.map((tier) => (
                <li>
                  <strong>{tier.label}:</strong> {tier.genres.join(", ")}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        content.summary.strengths.length > 0 && (
          <div class="summary-col">
            <h3>Strengths</h3>
            <ul>
              {content.summary.strengths.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        )
      }
      {
        content.summary.weaknesses.length > 0 && (
          <div class="summary-col">
            <h3>Weaknesses</h3>
            <ul>
              {content.summary.weaknesses.map((w) => (
                <li>{w}</li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    {/* ── 2. Specifications ── */}
    <section class="card">
      <h2 id="specifications">
        Specifications{" "}
        <span class="field-count">{specCount}/{specTotal}</span>
      </h2>
      <table class="spec-table">
        <tbody>
          <tr>
            <td>Optical construction</td>
            <td>
              {
                lens.opticalElements != null && lens.opticalGroups != null ? (
                  <>
                    {lens.opticalElements} elements in {lens.opticalGroups}{" "}
                    groups
                    {lens.specialElements &&
                      lens.specialElements.length > 0 && (
                        <span class="special-elements">
                          {" "}
                          ({lens.specialElements.join(", ")})
                        </span>
                      )}
                  </>
                ) : (
                  DASH
                )
              }
            </td>
          </tr>
          <tr>
            <td>Coating</td>
            <td
              >{
                lens.coating && lens.coating.length > 0
                  ? lens.coating.join(", ")
                  : DASH
              }</td
            >
          </tr>
          <tr
            ><td>Focal length</td><td
              >{formatFL(lens.focalLengthMin, lens.focalLengthMax)}</td
            ></tr
          >
          <tr><td>Max aperture</td><td>f/{lens.maxAperture}</td></tr>
          <tr>
            <td>Sweet spot</td>
            <td
              >{
                lens.sweetSpotAperture ? `f/${lens.sweetSpotAperture}` : DASH
              }</td
            >
          </tr>
          <tr>
            <td>Aperture blades</td>
            <td>
              {
                lens.apertureBlades != null
                  ? `${lens.apertureBlades}${lens.hasCircularAperture ? " (circular)" : ""}`
                  : DASH
              }
            </td>
          </tr>
          <tr>
            <td>Sunstar points</td>
            <td>
              {
                lens.apertureBlades != null ? (
                  <>
                    {lens.apertureBlades % 2 === 0
                      ? lens.apertureBlades
                      : lens.apertureBlades * 2}
                    {lens.hasCircularAperture
                      ? " (soft — circular blades)"
                      : " (sharp — straight blades)"}
                  </>
                ) : (
                  DASH
                )
              }
            </td>
          </tr>
          <tr>
            <td>Max magnification</td>
            <td
              >{
                lens.maxMagnification != null
                  ? `${lens.maxMagnification}x`
                  : DASH
              }</td
            >
          </tr>
          <tr
            ><td>Min focus distance</td><td
              >{num(lens.minFocusDistance, "mm")}</td
            ></tr
          >
          <tr><td>AF motor</td><td>{lens.afMotor ?? "Manual focus"}</td></tr>
          <tr><td>OIS</td><td>{yesNo(lens.hasOis)}</td></tr>
          <tr><td>Weather sealed</td><td>{yesNo(lens.isWeatherSealed)}</td></tr>
          <tr><td>Aperture ring</td><td>{yesNo(lens.hasApertureRing)}</td></tr>
          <tr
            ><td>Clickless aperture</td><td
              >{yesNo(lens.isApertureClickless)}</td
            ></tr
          >
          <tr><td>Focus ring</td><td>{yesNo(lens.hasFocusRing)}</td></tr>
          <tr><td>Focus by wire</td><td>{yesNo(lens.isFocusByWire)}</td></tr>
          <tr><td>Distance scale</td><td>{yesNo(lens.hasDistanceScale)}</td></tr
          >
          <tr><td>Rotating front</td><td>{yesNo(lens.hasRotatingFront)}</td></tr
          >
          <tr><td>Tripod mount</td><td>{yesNo(lens.hasTripodMount)}</td></tr>
          <tr><td>Weight</td><td>{lens.weight}g</td></tr>
          <tr><td>Diameter</td><td>{num(lens.diameter, "mm")}</td></tr>
          <tr><td>Length</td><td>{num(lens.length, "mm")}</td></tr>
          <tr><td>Filter thread</td><td>{num(lens.filterThread, "mm")}</td></tr>
          <tr><td>Year</td><td>{lens.year ?? DASH}</td></tr>
        </tbody>
      </table>

      {
        isTiltShift && (
          <>
            <h3>Tilt-Shift</h3>
            <table class="spec-table">
              <tbody>
                {lens.shiftRange && (
                  <tr>
                    <td>Shift range</td>
                    <td>{lens.shiftRange}mm</td>
                  </tr>
                )}
                {lens.tiltAngle && (
                  <tr>
                    <td>Tilt angle</td>
                    <td>{lens.tiltAngle}deg</td>
                  </tr>
                )}
                {lens.imageCircle && (
                  <tr>
                    <td>Image circle</td>
                    <td>{lens.imageCircle}mm</td>
                  </tr>
                )}
                {lens.isTiltShiftIndependent != null && (
                  <tr>
                    <td>Independent T/S</td>
                    <td>{yesNo(lens.isTiltShiftIndependent)}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </>
        )
      }

      {
        mtf && (
          <>
            <h3>MTF Charts</h3>
            {mtf.charts.map((chart) => (
              <div class="mtf-block">
                <span class="mtf-aperture">
                  {chart.aperture}
                  {chart.focalLength != null && (
                    <span class="mtf-focal"> @ {chart.focalLength}mm</span>
                  )}
                </span>
                {chart.confidence === "LOW" && (
                  <div class="mtf-confidence-badge" role="note">
                    <span class="mtf-confidence-label">
                      Low confidence{chart.confidenceReason ? ":" : ""}
                    </span>
                    {chart.confidenceReason && (
                      <span class="mtf-confidence-reason">
                        {MTF_REASON_PHRASES[chart.confidenceReason] ??
                          chart.confidenceReason}
                      </span>
                    )}
                    <a href="/wiki/mtf-confidence/" class="mtf-confidence-link">
                      Why?
                    </a>
                  </div>
                )}
                <MtfChart chart={chart} />
                {(() => {
                  // Per-chart frequency set, sorted low → high. Built
                  // from the actual rows so a brand that publishes at
                  // {15, 20, 40} gets those columns, not the canonical
                  // {10, 30}.
                  const chartFrequencies = Array.from(
                    new Set(
                      chart.readings.flatMap((r) =>
                        Object.keys(r.samples).map(Number),
                      ),
                    ),
                  ).sort((a, b) => a - b);
                  return (
                    <table class="spec-table mtf-table">
                      <thead>
                        <tr>
                          <th>Position</th>
                          {chartFrequencies.flatMap((f) => [
                            <th>{f}S</th>,
                            <th>{f}M</th>,
                          ])}
                        </tr>
                      </thead>
                      <tbody>
                        {chart.readings.map((r) => (
                          <tr>
                            <td>
                              {r.position === 0 ? "Center" : `${r.position}mm`}
                            </td>
                            {chartFrequencies.flatMap((f) => [
                              <td>{r.samples[f]?.S?.toFixed(2) ?? DASH}</td>,
                              <td>{r.samples[f]?.M?.toFixed(2) ?? DASH}</td>,
                            ])}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  );
                })()}
              </div>
            ))}
            <p class="mtf-source">
              Source:{" "}
              <a href={mtf.source} target="_blank" rel="noopener noreferrer">
                Official manufacturer specifications
              </a>
            </p>
          </>
        )
      }
    </section>

    {/* ── 3. Optical Quality ── */}
    <section class="card">
      <h2 id="optical-quality">
        Optical Quality{" "}
        <span class="field-count">
          {fieldCount}/{totalFields}
        </span>
      </h2>
      {
        hasOptical ? (
          <>
            <table class="spec-table oq-table">
              <tbody>
                {opticalFields.map(
                  ([label, val]) =>
                    val != null && (
                      <tr>
                        <td>{label}</td>
                        <td>
                          <div class="pip-row">
                            <span class="pips">
                              {[0.5, 1.0, 1.5, 2.0].map((threshold) => (
                                <span
                                  class={`pip ${val >= threshold ? "pip-on" : "pip-off"}`}
                                />
                              ))}
                            </span>
                            <span class="pip-val">{val.toFixed(1)}</span>
                          </div>
                        </td>
                      </tr>
                    ),
                )}
              </tbody>
            </table>
          </>
        ) : (
          <p class="empty-text">
            {lens.scoringStatus
              ? SCORING_STATUS_PHRASES[lens.scoringStatus]
              : "Limited professional review coverage for this lens."}
          </p>
        )
      }
      {
        content.opticalClusters && (
          <>
            {content.opticalClusters.sharpness.length > 0 && (
              <div class="field-group">
                <h3>Sharpness</h3>
                <ul class="assessment-list">
                  {content.opticalClusters.sharpness.map((a) => (
                    <li class={a.isStrength ? "strength" : "weakness"}>
                      {a.phrase}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {content.opticalClusters.aberrations.length > 0 && (
              <div class="field-group">
                <h3>Aberrations</h3>
                <ul class="assessment-list">
                  {content.opticalClusters.aberrations.map((a) => (
                    <li class={a.isStrength ? "strength" : "weakness"}>
                      {a.phrase}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {content.opticalClusters.rendering.length > 0 && (
              <div class="field-group">
                <h3>Rendering</h3>
                <ul class="assessment-list">
                  {content.opticalClusters.rendering.map((a) => (
                    <li class={a.isStrength ? "strength" : "weakness"}>
                      {a.phrase}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {content.opticalClusters.distortion.length > 0 && (
              <div class="field-group">
                <h3>Distortion</h3>
                <ul class="assessment-list">
                  {content.opticalClusters.distortion.map((a) => (
                    <li class={a.isStrength ? "strength" : "weakness"}>
                      {a.phrase}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <p class="methodology-note">
              All optical scores are based on lab measurements and field tests
              from trusted review sources. For details on how we score lenses,
              see our{" "}
              <a href="/wiki/scoring-methodology/">scoring methodology</a>.
            </p>
          </>
        )
      }
    </section>

    {/* ── 4. Genre Fit ── */}
    {
      content.genreFit.length > 0 && (
        <section class="card">
          <h2 id="genre-fit">Genre Fit</h2>
          <div class="genre-chips">
            {content.genreFit.map((entry) => (
              <a
                href={`#genre-${entry.genre}`}
                class={`genre-chip ${entry.mark >= 4 ? "chip-fit" : entry.mark >= 2.5 ? "chip-adequate" : "chip-avoid"}`}
              >
                <span
                  class={`genre-chip-indicator ${entry.mark >= 4 ? "fit-yes" : "fit-neutral"}`}
                >
                  {entry.mark >= 4
                    ? "\u2713"
                    : entry.mark >= 2.5
                      ? "~"
                      : "\u2717"}
                </span>
                <span class="genre-chip-name">
                  {entry.name.replace(" Photography", "")}
                </span>
                <span class="genre-chip-quality">
                  {entry.mark >= 4.5
                    ? "Excellent"
                    : entry.mark >= 4
                      ? "Good"
                      : entry.mark >= 2.5
                        ? "Adequate"
                        : "Avoid"}
                </span>
              </a>
            ))}
          </div>
          {content.genreFit.map((entry) => (
            <div class="genre-section" id={`genre-${entry.genre}`}>
              <h3>
                <span
                  class={`genre-indicator ${entry.mark >= 4 ? "fit-yes" : "fit-neutral"}`}
                >
                  {entry.mark >= 4
                    ? "\u2713"
                    : entry.mark >= 2.5
                      ? "~"
                      : "\u2717"}
                </span>
                <a href={`/genre/${entry.genre}/`}>{entry.name}</a>
                <span class="genre-mark-inline">{entry.mark}/5</span>
              </h3>
              <p>{entry.verdict}</p>
              {entry.primary.length > 0 && (
                <div class="field-group">
                  <span class="field-group-label">Primary</span>
                  <ul class="assessment-list">
                    {entry.primary.map((a) => (
                      <li class={a.isStrength ? "strength" : "weakness"}>
                        {a.phrase}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {entry.secondary.length > 0 && (
                <div class="field-group">
                  <span class="field-group-label">Secondary</span>
                  <ul class="assessment-list">
                    {entry.secondary.map((a) => (
                      <li class={a.isStrength ? "strength" : "weakness"}>
                        {a.phrase}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))}
        </section>
      )
    }

    {/* ── 5. Reviews ── */}
    {
      lens.reviewSources && Object.keys(lens.reviewSources).length > 0 && (
        <section class="card">
          <h2 id="reviews">Reviews</h2>
          <div class="link-row">
            {Object.entries(lens.reviewSources).map(([source, url]) => (
              <a
                href={url}
                target="_blank"
                rel="nofollow sponsored"
                class="link-button"
              >
                {reviewSourceDirectory[
                  source as keyof typeof reviewSourceDirectory
                ]?.name ?? source}
              </a>
            ))}
          </div>
        </section>
      )
    }

    {/* ── 6. Community ── */}
    {
      lens.communityNotes && lens.communityNotes.length > 0 && (
        <section class="card">
          <h2 id="community">Community</h2>
          <ul class="community-list">
            {lens.communityNotes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* ── 7. Alternatives ─�� */}
    {
      content.alternatives.length > 0 && (
        <section class="card">
          <h2 id="alternatives">Alternatives</h2>
          <div class="alt-grid">
            {content.alternatives.map((alt) => (
              <a href={`/lenses/${alt.slug}/`} class="alt-card">
                {alt.brand} {alt.model}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <a href="/lenses/" class="back-link">Back to Lens Explorer</a>
  </div>

  <button id="back-to-top" aria-label="Back to top">↑</button>
  <script is:inline>
    const btn = document.getElementById("back-to-top");
    window.addEventListener("scroll", () => {
      btn.classList.toggle("visible", window.scrollY > 300);
    });
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  </script>
</Base>

<style>
  .detail {
    max-width: 42rem;
    margin: 0 auto;
    --color-border: #606880;
  }

  /* ── Header ── */
  .header {
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .header h1 {
    margin-bottom: var(--space-xs);
  }

  .field-count {
    font-size: var(--font-size-sm);
    font-weight: 400;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  /* ── Table of Contents ── */
  .toc {
    margin-bottom: var(--space-lg);
  }

  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc a {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-link);
  }

  /* ── Cards ── */
  .card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .card-empty {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  /* ── Headings ── */
  h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 4rem;
