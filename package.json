{
  "name": "wuseria",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "check": "astro check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:report": "vitest run --coverage --reporter=default --reporter=html --outputFile=reports/tests/index.html",
    "lighthouse": "npm run build && npx @lhci/cli autorun --config lighthouserc.json",
    "check:links": "npx tsx scripts/check-trailing-slashes.ts",
    "check:external-links": "npx tsx scripts/check-external-links.ts",
    "validate": "npm run lint && npm run format && npm run check && npm run test && npm run build && npm run check:links",
    "release": "bash scripts/release.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "vite": "^7"
  }
}
